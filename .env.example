PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGIN=http://127.0.0.1:5500

# Identity — real authentication is the default. Registration requires a
# university email on ALLOWED_EMAIL_DOMAIN; sessions last SESSION_TTL_DAYS.
# ALLOW_DEV_HEADER=true re-enables the dev x-user-id placeholder (never in prod).
ALLOWED_EMAIL_DOMAIN=stu.cu.edu.ng
SESSION_TTL_DAYS=30
ALLOW_DEV_HEADER=false