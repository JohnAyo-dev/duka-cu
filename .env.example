# Copy this file to `.env` and fill it in. The server reads `.env` on start
# (backend/env.js); a real environment variable always wins over the file.
# `.env` is git-ignored and is never served over HTTP.

PORT=3000
HOST=127.0.0.1

# The site and the API are served by the same process: `npm start`, then open
# http://localhost:3000 . These two are that address. Use https in production.
# Google's console wants "localhost", not 127.0.0.1.
PUBLIC_URL=http://localhost:3000
# Only set APP_URL if the pages are served from somewhere else than the API
# (for example VS Code Live Server on http://127.0.0.1:5500).
# APP_URL=http://127.0.0.1:5500
# ALLOWED_ORIGIN only matters in that split setup; it defaults to "*" for dev.
# ALLOWED_ORIGIN=http://127.0.0.1:5500

# Identity — registration requires a university email on ALLOWED_EMAIL_DOMAIN;
# sessions last SESSION_TTL_DAYS. ALLOW_DEV_HEADER=true re-enables the dev
# x-user-id placeholder (never in prod).
ALLOWED_EMAIL_DOMAIN=stu.cu.edu.ng
SESSION_TTL_DAYS=30
ALLOW_DEV_HEADER=false

# Admins (comma separated emails). They can approve or reject rider applications.
ADMIN_EMAILS=

# --- Sign-in providers -------------------------------------------------------
# A provider with no credentials reports itself as "not configured" and its
# button on the sign-in page is disabled. Step-by-step setup is in claude.md.
# Redirect URI to register with each provider:
#   {PUBLIC_URL}/api/v1/auth/oauth/<name>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple needs a paid developer account and an https domain (no localhost).
# APPLE_PRIVATE_KEY is the .p8 file's contents. Real newlines inside double
# quotes work, or put it on one line with \n escapes.
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Payments ------------------------------------------------------------------
# Public key: sent to the browser to open the Paystack window.
# Secret key: server only. It verifies the webhook signature that marks an
# order paid. In the Paystack dashboard set the webhook URL to
#   {PUBLIC_URL}/api/v1/webhooks/paystack
# Checkout stays switched off until both are set.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Abuse protection and logging (all optional; these are the defaults) -------
# RATE_LIMIT_AUTH_PER_MIN=20        sign-in / register / OAuth, per IP
# RATE_LIMIT_WRITE_PER_MIN=120      every other write, per IP
# MAX_ACTIVE_LISTINGS_PER_USER=25
# LOG_REQUESTS=true                 one JSON line per request
# TRUST_PROXY=false                 set true behind a reverse proxy so the real client IP is used
